<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup (Android 12+, D-03): the database and settings go into the Google backup
     and along to a new phone. Nothing leaves the phone otherwise. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
